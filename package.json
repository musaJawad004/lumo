      "^phosphor-react-native/src/icons/(.*)$": "<rootDir>/jest.icon-stub.js",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
